{
  "name": "@ragportfolio/ask",
  "version": "0.1.3",
  "description": "Embeddable React Ask widget for ragportfolio/memory backends.",
  "type": "module",
  "main": "./dist/ragportfolio-ask.umd.cjs",
  "module": "./dist/ragportfolio-ask.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ragportfolio-ask.js",
      "require": "./dist/ragportfolio-ask.umd.cjs"
    },
    "./styles.css": "./dist/ragportfolio-ask.css"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
